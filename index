<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
  <meta name="description" content="Maquette commerciale — extensions de cheveux & parcours de réservation." />
  <title>Studio Hair — Maquette Extensions</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Italiana&display=swap" rel="stylesheet">
  <style>
    :root{
      --ink:#171310;
      --muted:#6f665f;
      --cream:#f4efe9;
      --paper:#fcfaf7;
      --taupe:#c8b6a7;
      --line:#ded4cb;
      --rose:#d8b7b2;
      --white:#fff;
      --max:1240px;
      --serif:"Italiana", Georgia, serif;
      --sans:"DM Sans", Arial, sans-serif;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);line-height:1.5}
    img{display:block;width:100%}
    a{text-decoration:none;color:inherit}
    button,input{font:inherit}
    button,a,[role="button"]{touch-action:manipulation;-webkit-tap-highlight-color:transparent}
    .wrap{width:min(var(--max),calc(100% - 40px));margin:auto}
    .eyebrow{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:#8a7668;font-weight:600}
    .serif{font-family:var(--serif);font-weight:400}
    h1,h2,h3,p{margin-top:0}
    h1{font-family:var(--serif);font-size:clamp(54px,7vw,104px);line-height:.92;letter-spacing:-.03em;font-weight:400}
    h2{font-family:var(--serif);font-size:clamp(40px,5vw,72px);line-height:1;letter-spacing:-.02em;font-weight:400}
    h3{font-family:var(--serif);font-size:30px;line-height:1.1;font-weight:400}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 22px;border:1px solid var(--ink);border-radius:999px;background:var(--ink);color:white;font-weight:600;cursor:pointer;transition:.25s ease}
    .btn:hover{transform:translateY(-2px);background:#2a231f}
    .btn.light{background:transparent;color:var(--ink)}
    .btn.light:hover{background:#fff}
    .btn.white{background:white;color:var(--ink);border-color:white}
    .link{font-weight:600;border-bottom:1px solid var(--ink);padding-bottom:3px}
    .section{padding:96px 0}
    .section-head{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:44px}
    .section-head p{max-width:520px;color:var(--muted);margin-bottom:6px}

    /* Header */
    header{position:sticky;top:0;z-index:50;background:rgba(252,250,247,.92);backdrop-filter:blur(16px);border-bottom:1px solid rgba(222,212,203,.7)}
    nav{height:76px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:24px}
    .brand{font-family:var(--serif);font-size:28px;letter-spacing:.08em;white-space:nowrap}
    .brand small{display:block;font:600 9px var(--sans);letter-spacing:.28em;margin-top:2px;color:var(--muted)}
    .navlinks{display:flex;gap:24px;justify-content:center;font-size:14px;color:#403932}
    .navlinks a:hover{color:#000}
    .mini-tag{font-size:10px;text-transform:uppercase;letter-spacing:.18em;border:1px solid var(--line);padding:7px 10px;border-radius:999px;margin-left:8px;font-family:var(--sans)}

    /* Hero */
    .hero{min-height:calc(100vh - 76px);display:grid;grid-template-columns:1.02fr .98fr;background:var(--cream);overflow:hidden}
    .hero-copy{padding:90px max(40px,calc((100vw - var(--max))/2)) 70px max(40px,calc((100vw - var(--max))/2));padding-right:62px;display:flex;flex-direction:column;justify-content:center}
    .hero-copy h1{max-width:760px;margin:18px 0 24px}
    .hero-copy .lead{font-size:20px;max-width:620px;color:#50473f;margin-bottom:32px}
    .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:34px}
    .microproof{display:flex;gap:24px;flex-wrap:wrap;padding-top:26px;border-top:1px solid #cfc1b5;font-size:13px;color:#5e554d}
    .microproof span{display:flex;align-items:center;gap:8px}
    .dot{width:6px;height:6px;background:var(--ink);border-radius:50%}
    .hero-media{position:relative;min-height:760px}
    .hero-media img{height:100%;object-fit:cover;object-position:center 38%}
    .hero-media:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(244,239,233,.18),transparent 28%,rgba(0,0,0,.08))}
    .hero-note{position:absolute;z-index:2;right:28px;bottom:28px;background:rgba(252,250,247,.9);backdrop-filter:blur(12px);padding:18px 20px;width:260px;border:1px solid rgba(255,255,255,.65)}
    .hero-note strong{display:block;font-family:var(--serif);font-size:26px;font-weight:400;margin-bottom:4px}
    .hero-note span{font-size:12px;color:var(--muted)}

    /* Result strip */
    .result-strip{background:#1d1815;color:#fff;padding:26px 0}
    .result-strip .wrap{display:flex;justify-content:space-between;gap:24px;align-items:center}
    .result-strip strong{font-family:var(--serif);font-size:32px;font-weight:400}
    .result-strip p{margin:0;color:#d7cec7;font-size:14px}

    /* Goals */
    .goal-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
    .goal{display:block;padding:42px 34px;position:relative;min-height:260px;transition:.25s ease;cursor:pointer}
    .goal+ .goal{border-left:1px solid var(--line)}
    .goal:hover{background:#f1ebe5}
    .goal .num{font-size:12px;letter-spacing:.15em;color:#8d7c70;margin-bottom:48px;display:block}
    .goal h3{font-size:38px;margin-bottom:14px}
    .goal p{color:var(--muted);max-width:290px}
    .goal .arrow{position:absolute;right:28px;bottom:28px;font-size:24px}

    /* Before after */
    .ba{display:grid;grid-template-columns:1.08fr .92fr;gap:58px;align-items:center}
    .ba-visual{display:grid;grid-template-columns:1fr 1fr;gap:4px;position:relative}
    .ba-visual figure{margin:0;position:relative;height:620px;overflow:hidden;background:#ddd}
    .ba-visual img{height:100%;object-fit:cover}
    .ba-visual figure:first-child img{object-position:center 35%}
    .ba-visual figcaption{position:absolute;left:18px;bottom:18px;background:rgba(255,255,255,.92);padding:8px 12px;font-size:11px;letter-spacing:.15em;text-transform:uppercase}
    .demo-label{font-size:11px;color:#8f8278;margin-top:10px}
    .ba-copy .quote{font-family:var(--serif);font-size:42px;line-height:1.08;margin:18px 0 22px}
    .ba-copy p{color:var(--muted);max-width:500px}
    .ba-copy .btn{margin-top:10px}

    /* How it works */
    .steps{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line)}
    .step{padding:34px 26px 8px;border-right:1px solid var(--line)}
    .step:last-child{border-right:0}
    .step .n{width:42px;height:42px;border:1px solid var(--ink);border-radius:50%;display:grid;place-items:center;margin-bottom:28px;font-size:13px}
    .step h3{font-size:28px;margin-bottom:12px}
    .step p{font-size:14px;color:var(--muted)}
    .steps-cta{margin-top:46px;background:#e9dfd6;display:grid;grid-template-columns:1fr auto;align-items:center;padding:34px 38px;gap:26px}
    .steps-cta h3{margin:0;font-size:34px}
    .steps-cta p{margin:6px 0 0;color:#625950}

    /* Expertise */
    .expertise{display:grid;grid-template-columns:.9fr 1.1fr;min-height:660px;background:#1d1815;color:white}
    .expertise-media img{height:100%;object-fit:cover;object-position:center}
    .expertise-copy{padding:86px 80px;display:flex;flex-direction:column;justify-content:center}
    .expertise-copy .eyebrow{color:#bca99b}
    .expertise-copy h2{margin:14px 0 26px}
    .expertise-copy>p{color:#d0c6be;max-width:560px}
    .checks{margin-top:30px;border-top:1px solid #443a34}
    .check{display:grid;grid-template-columns:180px 1fr;gap:20px;padding:20px 0;border-bottom:1px solid #443a34}
    .check strong{font-size:13px;text-transform:uppercase;letter-spacing:.12em}
    .check span{color:#cfc5bd;font-size:14px}

    /* FAQ */
    .faq{max-width:930px;margin:0 auto}
    details{border-top:1px solid var(--line);padding:22px 0}
    details:last-child{border-bottom:1px solid var(--line)}
    summary{list-style:none;cursor:pointer;font-family:var(--serif);font-size:30px;display:flex;justify-content:space-between;gap:20px;align-items:center}
    summary::-webkit-details-marker{display:none}
    summary:after{content:"+";font-family:var(--sans);font-size:22px;font-weight:400}
    details[open] summary:after{content:"−"}
    details p{max-width:780px;color:var(--muted);margin:14px 0 2px;font-size:15px}

    /* Lashes */
    .lashes{display:grid;grid-template-columns:1fr 1fr;background:#eadfdc;align-items:stretch}
    .lashes-copy{padding:80px max(40px,calc((100vw - var(--max))/2));padding-right:70px}
    .lashes-copy h2{margin:16px 0 20px}
    .lashes-copy p{max-width:490px;color:#5b514b}
    .lashes-media{overflow:hidden;min-height:520px;background:#d5c0bc;position:relative}
    .lashes-media img{height:100%;object-fit:cover;object-position:center 28%;filter:saturate(.75) contrast(.95)}
    .lashes-media:after{content:"CILS • RÉSERVATION DIRECTE";position:absolute;left:22px;bottom:22px;background:rgba(252,250,247,.88);padding:9px 12px;font-size:11px;letter-spacing:.16em}

    /* Instagram */
    .insta-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
    .insta-grid .tile{aspect-ratio:1;overflow:hidden;position:relative;background:#e5ddd6}
    .insta-grid img{height:100%;object-fit:cover}
    .tile.text{display:flex;align-items:center;justify-content:center;padding:18px;text-align:center;font-family:var(--serif);font-size:24px;background:#e9dfd6}
    .tile.text.dark{background:#1d1815;color:#fff}
    .insta-footer{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:24px;color:var(--muted)}

    /* Final CTA */
    .final{position:relative;min-height:620px;color:white;display:grid;place-items:center;text-align:center;overflow:hidden}
    .final img{position:absolute;inset:0;height:100%;object-fit:cover;filter:brightness(.42);object-position:center 36%}
    .final:after{content:"";position:absolute;inset:0;background:linear-gradient(rgba(15,11,9,.2),rgba(15,11,9,.62))}
    .final-content{position:relative;z-index:2;max-width:820px;padding:50px 20px}
    .final h2{font-size:clamp(50px,6vw,88px);margin:12px 0 20px}
    .final p{font-size:18px;color:#ede5df;margin-bottom:30px}
    .final-actions{display:flex;justify-content:center;gap:12px;flex-wrap:wrap}

    footer{padding:34px 0;background:#15110f;color:#d6ccc4;font-size:13px}
    footer .wrap{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap}
    footer .note{color:#90857d}

    /* Floating mobile */
    .mobile-book{display:none;position:fixed;left:12px;right:12px;bottom:max(12px,env(safe-area-inset-bottom));z-index:70;background:var(--ink);color:#fff;border:0;border-radius:999px;height:56px;font-weight:700;box-shadow:0 12px 35px rgba(0,0,0,.22)}

    /* Modal */
    .modal{position:fixed;inset:0;z-index:100;display:none;background:rgba(18,14,12,.58);backdrop-filter:blur(8px);padding:20px;overflow:auto}
    .modal.open{display:grid;place-items:center}
    .modal:target{display:grid;place-items:center}
    .flow:target{display:block}
    body:has(.flow:target) .modal{display:grid;place-items:center}
    body:has(.flow:target) #pathGrid{display:none}
    .modal-card{background:var(--paper);width:min(860px,100%);min-height:520px;position:relative;padding:34px}
    .modal-close{position:absolute;right:22px;top:18px;border:0;background:transparent;font-size:30px;cursor:pointer}
    .modal-card h2{font-size:48px;margin:10px 0 12px}
    .modal-card>p{color:var(--muted);max-width:660px}
    .path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:34px}
    .path{display:block;color:inherit;border:1px solid var(--line);background:white;padding:24px;text-align:left;cursor:pointer;min-height:230px;transition:.2s ease}
    .path:hover{border-color:var(--ink);transform:translateY(-2px)}
    .path .kicker{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#8e7e73}
    .path h3{font-size:28px;margin:18px 0 10px}
    .path p{font-size:14px;color:var(--muted)}
    .path strong{display:block;margin-top:20px;font-size:13px}
    .flow{display:none;margin-top:24px;border-top:1px solid var(--line);padding-top:26px}
    .flow.active{display:block}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .field{display:flex;flex-direction:column;gap:7px}
    .field.full{grid-column:1/-1}
    .field label{font-size:12px;font-weight:600}
    .field input{padding:14px;border:1px solid var(--line);background:white}
    .date-row{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}
    .date-pill{padding:12px 14px;border:1px solid var(--line);background:white;cursor:pointer}
    .date-pill:hover{border-color:var(--ink)}
    .demo-note{margin-top:20px;background:#eee7e1;padding:12px 14px;font-size:12px;color:#685e56}

    @media (max-width:1000px){
      .navlinks{display:none}
      nav{grid-template-columns:1fr auto}
      .hero{grid-template-columns:1fr}
      .hero-copy{padding:64px 30px}
      .hero-media{min-height:560px}
      .goal-grid{grid-template-columns:1fr}
      .goal+.goal{border-left:0;border-top:1px solid var(--line)}
      .ba{grid-template-columns:1fr;gap:34px}
      .ba-visual figure{height:520px}
      .steps{grid-template-columns:1fr 1fr}
      .step:nth-child(2){border-right:0}
      .step:nth-child(-n+2){border-bottom:1px solid var(--line)}
      .expertise{grid-template-columns:1fr}
      .expertise-media{height:520px}
      .lashes{grid-template-columns:1fr}
      .lashes-copy{padding:64px 30px}
      .insta-grid{grid-template-columns:repeat(3,1fr)}
      .path-grid{grid-template-columns:1fr}
    }
    @media (max-width:680px){
      .wrap{width:min(100% - 28px,var(--max))}
      .section{padding:72px 0}
      header .btn{display:none}
      nav{height:64px}
      .brand{font-size:23px}
      .hero{min-height:auto}
      .hero-copy{padding:48px 20px 42px}
      h1{font-size:56px}
      .hero-copy .lead{font-size:17px}
      .hero-actions .btn{width:100%}
      .microproof{display:grid;gap:10px}
      .hero-media{min-height:480px}
      .hero-note{left:18px;right:18px;bottom:18px;width:auto}
      .result-strip .wrap{display:block}
      .result-strip strong{display:block;margin-bottom:8px}
      .section-head{display:block}
      .ba-visual{grid-template-columns:1fr 1fr;gap:2px}
      .ba-visual figure{height:430px}
      .steps{grid-template-columns:1fr}
      .step{border-right:0;border-bottom:1px solid var(--line)!important}
      .steps-cta{grid-template-columns:1fr;padding:28px 22px}
      .steps-cta .btn{width:100%}
      .expertise-copy{padding:60px 22px}
      .check{grid-template-columns:1fr;gap:6px}
      summary{font-size:25px}
      .lashes-media{min-height:420px}
      .insta-grid{grid-template-columns:repeat(2,1fr)}
      .insta-footer{display:block}
      .insta-footer .btn{margin-top:14px;width:100%}
      .mobile-book{display:flex!important}
      footer{padding-bottom:94px}
      .modal{padding:0;align-items:end}
      .modal-card{padding:28px 18px 32px;min-height:80vh;border-radius:20px 20px 0 0}
      .modal-card h2{font-size:40px}
      .form-grid{grid-template-columns:1fr}
      .field.full{grid-column:auto}
    }


    /* UX navigation added without changing the original visual direction */
    .flow-back{
      display:inline-flex;align-items:center;gap:8px;
      min-height:44px;padding:0 2px;margin:0 0 14px;
      border:0;background:transparent;color:var(--ink);
      font-weight:600;font-size:14px;cursor:pointer;text-decoration:none;
    }
    .flow-back:hover{opacity:.65}
    .flow-back .back-arrow{font-size:19px;line-height:1}
    .date-pill.selected{background:var(--ink);color:#fff;border-color:var(--ink)}
    .modal-close{width:44px;height:44px;display:grid;place-items:center;line-height:1}
    @media (max-width:700px){
      .modal{padding:0;align-items:end}
      .modal-card{
        width:100%;max-height:94svh;min-height:80vh;overflow-y:auto;
        -webkit-overflow-scrolling:touch;
        padding:24px 18px calc(32px + env(safe-area-inset-bottom));
        border-radius:20px 20px 0 0;
      }
      .modal-close{position:sticky;float:right;right:0;top:0;z-index:5;margin:-8px -6px 0 0;background:rgba(252,250,247,.94);border-radius:50%}
      .flow-back{min-height:48px;margin-top:0;margin-bottom:12px}
      .date-pill{min-height:46px;padding:12px 14px}
      .demo-submit{width:100%;min-height:52px}
    }
  

/* --- UX V3: preserve original design, improve booking flow + mobile usability --- */
.modal-close{
  width:44px;height:44px;display:flex;align-items:center;justify-content:center;
  border-radius:50%;background:rgba(255,255,255,.92);box-shadow:0 4px 18px rgba(18,14,12,.12);
  z-index:30;line-height:1;color:var(--ink);text-decoration:none;
}
.flow-back{display:inline-flex;align-items:center;gap:8px;margin-bottom:14px;color:var(--ink);font-size:14px;font-weight:600;text-decoration:none;min-height:44px;padding:0 4px}
.flow-step{display:none}
.flow-step.active{display:block}
.progress-wrap{margin:4px 0 20px}
.progress-top{display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:12px;color:var(--muted);margin-bottom:8px}
.progress-bar{height:3px;background:#e7ded7;overflow:hidden}
.progress-bar span{display:block;height:100%;background:var(--ink);width:25%;transition:width .25s ease}
.option-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:18px 0}
.option-card{border:1px solid var(--line);background:#fff;padding:16px;text-align:left;cursor:pointer;min-height:88px;color:var(--ink)}
.option-card.selected{border-color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}
.flow-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.flow-actions .btn{min-width:180px}
.summary-card{background:#fff;border:1px solid var(--line);padding:18px;margin:18px 0}
.summary-card p{margin:8px 0;color:var(--muted)}
.confirm-icon{width:58px;height:58px;border-radius:50%;display:grid;place-items:center;background:#eee7e1;font-size:28px;margin-bottom:18px}
.field select{padding:14px;border:1px solid var(--line);background:white;width:100%}

@media (max-width:680px){
  .modal{padding:0;align-items:stretch;overflow:hidden}
  .modal.open,.modal:target,body:has(.flow:target) .modal{place-items:stretch}
  .modal-card{
    width:100%;height:100dvh;min-height:100dvh;max-height:100dvh;
    border-radius:0;padding:calc(64px + env(safe-area-inset-top)) 18px calc(90px + env(safe-area-inset-bottom));
    overflow-y:auto;-webkit-overflow-scrolling:touch;
  }
  .modal-close{
    position:fixed;right:14px;top:calc(10px + env(safe-area-inset-top));
    width:46px;height:46px;font-size:28px;background:#fff;
  }
  .modal-card h2{font-size:36px;line-height:1.02;padding-right:42px}
  .path-grid{gap:10px;margin-top:24px}
  .path{min-height:auto;padding:18px}
  .path h3{font-size:23px;margin:12px 0 8px}
  .flow{margin-top:0;border-top:0;padding-top:0}
  .flow-back{
    position:sticky;top:calc(-54px - env(safe-area-inset-top));
    background:var(--paper);z-index:20;margin:-6px 0 10px;padding:10px 0;
  }
  .date-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
  .date-pill{min-height:48px;width:100%;font-size:14px}
  .option-grid{grid-template-columns:1fr}
  .option-card{min-height:76px}
  .flow-actions{position:sticky;bottom:calc(-72px - env(safe-area-inset-bottom));background:var(--paper);padding:12px 0 4px;z-index:10}
  .flow-actions .btn{width:100%;min-width:0}
  .field input,.field select{font-size:16px;min-height:50px}
  .progress-wrap{margin-top:0}
}

</style>
</head>
<body>
<header>
  <nav class="wrap">
    <a href="#top" class="brand">STUDIO HAIR <span class="mini-tag">maquette</span><small>EXTENSIONS • BEAUTY</small></a>
    <div class="navlinks">
      <a href="#results">Résultats</a>
      <a href="#goals">Extensions</a>
      <a href="#process">Comment ça marche</a>
      <a href="#faq">FAQ</a>
      <a href="#lashes">Cils</a>
    </div>
    <a class="btn open-book" href="#bookingModal" role="button">Prendre rendez-vous <span>→</span></a>
  </nav>
</header>

<main id="top">
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Extensions de cheveux sur mesure</span>
      <h1>La chevelure que vous imaginez, pensée pour vous.</h1>
