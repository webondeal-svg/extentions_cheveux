<script>
  const modal=document.getElementById('bookingModal');
  const flows=[...document.querySelectorAll('.flow')];
  const pathGrid=document.getElementById('pathGrid');
  const bookingStart=document.getElementById('bookingStart');
  const intentInput=document.getElementById('intentInput');

  function updateProgress(flow){
    const active=flow.querySelector('.flow-step.active');
    const total=parseInt(flow.dataset.total||'1',10);
    const label=flow.querySelector('.progress-label');
    const bar=flow.querySelector('.progress-bar span');
    if(!active || active.dataset.step==='done'){ if(label) label.textContent='Terminé'; if(bar) bar.style.width='100%'; return; }
    const step=parseInt(active.dataset.step,10);
    if(label) label.textContent=`Étape ${step} sur ${total}`;
    if(bar) bar.style.width=`${(step/total)*100}%`;
  }
  function setStep(flow,step){
    flow.querySelectorAll('.flow-step').forEach(s=>s.classList.remove('active'));
    const target=flow.querySelector(`.flow-step[data-step="${step}"]`);
    if(target) target.classList.add('active');
    updateProgress(flow);
    const card=modal.querySelector('.modal-card'); if(card) card.scrollTo({top:0,behavior:'smooth'});
  }
  function resetFlows(){
    flows.forEach(f=>{f.classList.remove('active'); setStep(f,1);});
    if(pathGrid) pathGrid.style.display='grid';
    if(bookingStart) bookingStart.style.display='block';
    document.querySelectorAll('.date-pill.selected,.option-card.selected').forEach(p=>p.classList.remove('selected'));
  }
  function openModal(flow=null,intent=''){
    modal.classList.add('open'); modal.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; resetFlows();
    if(intent && intentInput) intentInput.value=intent;
    if(flow){ showFlow(flow); }
  }
  function showFlow(name){
    if(bookingStart) bookingStart.style.display='none';
    if(pathGrid) pathGrid.style.display='none';
    flows.forEach(f=>f.classList.remove('active'));
    const flow=document.getElementById('flow-'+name); if(flow){flow.classList.add('active');setStep(flow,1);}
  }
  function backToStart(){
    flows.forEach(f=>f.classList.remove('active'));
    if(bookingStart) bookingStart.style.display='block';
    if(pathGrid) pathGrid.style.display='grid';
    const card=modal.querySelector('.modal-card'); if(card) card.scrollTo({top:0,behavior:'smooth'});
  }
  function closeModal(){ modal.classList.remove('open'); modal.setAttribute('aria-hidden','true'); document.body.style.overflow=''; resetFlows(); }

  document.querySelectorAll('.open-book').forEach(el=>el.addEventListener('click',(e)=>{e.preventDefault();openModal(null,el.dataset.intent||'');}));
  document.querySelectorAll('.open-photo').forEach(el=>el.addEventListener('click',(e)=>{e.preventDefault();openModal('photo');}));
  document.querySelectorAll('.open-lashes').forEach(el=>el.addEventListener('click',(e)=>{e.preventDefault();openModal('lashes');}));
  document.querySelectorAll('.path').forEach(el=>el.addEventListener('click',(e)=>{e.preventDefault();showFlow(el.dataset.flow);}));
  document.querySelectorAll('.flow-back').forEach(btn=>btn.addEventListener('click',(e)=>{e.preventDefault();backToStart();}));

  document.querySelectorAll('.date-row').forEach(row=>row.addEventListener('click',e=>{
    const pill=e.target.closest('.date-pill'); if(!pill) return;
    row.querySelectorAll('.date-pill').forEach(p=>p.classList.remove('selected')); pill.classList.add('selected');
  }));
  document.querySelectorAll('.option-grid').forEach(grid=>grid.addEventListener('click',e=>{
    const card=e.target.closest('.option-card'); if(!card) return;
    grid.querySelectorAll('.option-card').forEach(p=>p.classList.remove('selected')); card.classList.add('selected');
  }));

  document.querySelectorAll('.next-step').forEach(btn=>btn.addEventListener('click',()=>{
    const flow=btn.closest('.flow'); const current=flow.querySelector('.flow-step.active'); const n=parseInt(current.dataset.step,10); setStep(flow,n+1);
  }));
  document.querySelectorAll('.prev-step').forEach(btn=>btn.addEventListener('click',()=>{
    const flow=btn.closest('.flow'); const current=flow.querySelector('.flow-step.active'); const n=parseInt(current.dataset.step,10); setStep(flow,Math.max(1,n-1));
  }));
  document.querySelectorAll('.finish-flow').forEach(btn=>btn.addEventListener('click',()=>{const flow=btn.closest('.flow');setStep(flow,'done');}));
  document.querySelectorAll('.close-flow').forEach(btn=>btn.addEventListener('click',closeModal));

  const closeBtn=document.querySelector('.modal-close');
  if(closeBtn) closeBtn.addEventListener('click',(e)=>{e.preventDefault();closeModal();history.replaceState(null,'',location.pathname+location.search+'#top');});
  modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
</script>
</body>
</html>
